# Copy to .env.local for local development. On Vercel, set these in Project Settings -> Environment Variables.

# --- Backend (the FastAPI app)
BACKEND_URL=http://localhost:8000
# "bearer" sends BACKEND_API_KEY (must equal API_KEY in the backend's .env; leave both empty locally).
# "aws_iam" signs requests with SigV4 for a Lambda Function URL (phase 6), using Vercel OIDC: no AWS keys.
BACKEND_AUTH=bearer
BACKEND_API_KEY=
# Only for BACKEND_AUTH=aws_iam: the IAM role Vercel assumes through OIDC
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/connoisseur-vercel
# AWS_REGION=us-east-1

# --- Auth.js (GitHub login). Without the GitHub pair, `next dev` runs as a local guest and
# production shows "sign-in is not configured".
# Generate a secret with: npx auth secret
AUTH_SECRET=
# GitHub -> Settings -> Developer settings -> OAuth Apps. Callback URL: <site>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
