# Copy to .env. Everything is optional: the defaults run fully locally with Ollama.

# Only needed by src/connoisseur/client.py (MCP sampling is delegated to Claude)
ANTHROPIC_API_KEY=

# Local models served by Ollama
CHAT_MODEL=llama3.1
EXTRACTION_MODEL=llama3

# Where notebooks 03-05 persist the ChromaDB index (default: ~/chroma_multimodal)
# CHROMA_DIR=

# Override the data directory (default: ./data)
# CONNOISSEUR_DATA_DIR=
