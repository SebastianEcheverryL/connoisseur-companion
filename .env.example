# Copy to .env. Everything is optional: the defaults run fully locally with Ollama.

# --- LLM provider: "ollama" (local, free) or "bedrock" (AWS, needs `pip install -e ".[aws]"`)
LLM_PROVIDER=ollama
CHAT_MODEL=llama3.1
EXTRACTION_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434
# BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# AWS_REGION=us-east-1

# --- Agent behaviour
# Skip the three expert agents for faster local answers
# ENABLE_EXPERT_ANALYSIS=true
# Below this many local results, the web-search agent also runs
# MIN_LOCAL_RESULTS=3

# --- Web search
# Nominatim's usage policy asks for an identifying User-Agent with a contact URL or email
# OSM_USER_AGENT=connoisseur-companion/0.2 (+https://github.com/<you>/connoisseur-companion)
# Free tier at https://tavily.com (about 1,000 searches/month). Without it, only OpenStreetMap is used.
# TAVILY_API_KEY=

# --- Paths
# CHROMA_DIR=./.chroma
# CONNOISSEUR_DATA_DIR=./data

# --- Logging
# LOG_LEVEL=INFO
# LOG_JSON=false
